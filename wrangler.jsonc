{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "compatibility_date": "2026-09-01",

  // Assets-only Worker: no server code, Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  // The zone must be active in this Cloudflare account.
  "routes": [
    {
      "pattern": "recipes.vikramrai.com",
      "custom_domain": true
    }
  ]
}
