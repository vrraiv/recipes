---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A household recipe collection.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Private family collection: keep it out of search indexes. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a href="/">The Recipe Box</a>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
